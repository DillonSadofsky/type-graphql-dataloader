{
  "name": "@isoft-data-systems/type-graphql-dataloader",
  "description": "A utility to use DataLoader with TypeGraphQL without fuss",
  "version": "0.6.3",
  "author": {
    "name": "Dillon Sadofsky",
    "url": "https://github.com/ISoft-Data-Systems"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ISoft-Data-Systems/type-graphql-dataloader.git"
  },
  "keywords": [
    "typescript",
    "graphql",
    "dataloader",
    "typeorm"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/ISoft-Data-Systems/type-graphql-dataloader/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "files": [
    "./dist/**/*.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -w -p tsconfig.json",
    "clean": "rimraf dist",
    "dev:typeorm": "ts-node-dev -r tsconfig-paths/register examples/typeorm/index.ts",
    "test": "node --test dist/tests/typeorm.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "dependencies": {
    "@lukeed/uuid": "^2.0.1",
    "dataloader": "^2.2.3",
    "lodash-es": "^4.17.22",
    "reflect-metadata": "^0.1.14",
    "typedi": "^0.10.0"
  },
  "devDependencies": {
    "@apollo/server": "^5.2.0",
    "@as-integrations/express5": "^1.1.2",
    "@eslint/js": "^10.0.1",
    "@types/body-parser": "^1.19.6",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.21",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.0.3",
    "body-parser": "^2.2.0",
    "class-validator": "^0.14.3",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "express": "^5.2.1",
    "graphql": "^16.6.0",
    "graphql-request": "^6.1.0",
    "graphql-scalars": "^1.25.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.2",
    "sqlite3": "^5.1.7",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "type-graphql": "^2.0.0-rc.2",
    "typeorm": "^0.3.28",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "peerDependencies": {
    "typeorm": ">=0.3.17"
  }
}
